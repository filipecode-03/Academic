generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id             String               @id @default(cuid())
  name           String
  slug           String               @unique
  description    String?
  price          Decimal              @db.Decimal(10, 2)
  stock          Int                  @default(0)
  details        Json                 @default("[]")
  image          String?
  status         ProductStatus        @default(ACTIVE)
  featured       Boolean              @default(false)
  newUntil       DateTime?
  featuredStartAt DateTime?
  featuredEndAt   DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  homeBanners    HomeBanner[]
  homeSections   HomeSectionProduct[]
  collections    ProductCollection[]
  images         ProductImage[]
  orderItems     OrderItem[]

  @@index([newUntil])
  @@index([featured, featuredStartAt, featuredEndAt])
}

model Order {
  id        String      @id @default(cuid())
  status    OrderStatus @default(PENDING)
  total     Decimal     @db.Decimal(10, 2)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  items     OrderItem[]
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String?
  productName String
  unitPrice   Decimal  @db.Decimal(10, 2)
  quantity    Int
  subtotal    Decimal  @db.Decimal(10, 2)
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model ProductImage {
  id        String   @id @default(cuid())
  image     String
  order     Int      @default(0)
  productId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, order])
}

model Collection {
  id           String              @id @default(cuid())
  name         String
  slug         String              @unique
  description  String?
  image        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  banners      HomeBanner[]
  homeSections HomeSection[]
  products     ProductCollection[]
  homeBlocks   HomeCollectionBlock[]
  navbarItems  NavbarItem[]
}

model NavbarItem {
  id              String                 @id @default(cuid())
  title           String
  type            NavbarItemType
  destinationType NavbarDestinationType?
  collectionId    String?
  externalUrl     String?
  parentId        String?
  order           Int                    @default(0)
  active          Boolean                @default(true)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  collection      Collection?            @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  parent          NavbarItem?            @relation("NavbarItemHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children        NavbarItem[]           @relation("NavbarItemHierarchy")

  @@index([parentId, order])
  @@index([active, order])
  @@index([collectionId])
}

model ProductCollection {
  productId    String
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
}

model HomeBanner {
  id              String                @id @default(cuid())
  image           String
  order           Int
  active          Boolean               @default(true)
  destinationType BannerDestinationType @default(NONE)
  productId       String?
  collectionId    String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  title           String
  description     String?
  collection      Collection?           @relation(fields: [collectionId], references: [id])
  product         Product?              @relation(fields: [productId], references: [id])

  @@index([order])
  @@index([active])
}

model PromoNotice {
  id        String              @id @default(cuid())
  content   String
  position  PromoNoticePosition
  order     Int                 @default(0)
  active    Boolean             @default(true)
  startAt   DateTime
  endAt     DateTime
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([position])
  @@index([active])
  @@index([startAt, endAt])
}

model HomeSection {
  id           String               @id @default(cuid())
  title        String
  type         HomeSectionType
  order        Int
  active       Boolean              @default(true)
  collectionId String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  collection   Collection?          @relation(fields: [collectionId], references: [id])
  products     HomeSectionProduct[]

  @@index([order])
  @@index([active])
}

model HomeCollectionBlock {
  id           String     @id @default(cuid())
  image        String
  title        String
  collectionId String
  order        Int        @default(0)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([order])
  @@index([active])
  @@index([collectionId])
}

model HomeSectionProduct {
  homeSectionId String
  productId     String
  order         Int
  homeSection   HomeSection @relation(fields: [homeSectionId], references: [id], onDelete: Cascade)
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([homeSectionId, productId])
  @@index([homeSectionId, order])
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  PENDING
  CONTACTED
  COMPLETED
  CANCELLED
}

enum BannerDestinationType {
  NONE
  PRODUCT
  COLLECTION
}

enum PromoNoticePosition {
  TOP
  BELOW_CAROUSEL
}

enum HomeSectionType {
  MANUAL
  COLLECTION
}

enum NavbarItemType {
  LINK
  DROPDOWN
}

enum NavbarDestinationType {
  COLLECTION
  ALL_PRODUCTS
  NEW_PRODUCTS
  FEATURED_PRODUCTS
  EXTERNAL
}
